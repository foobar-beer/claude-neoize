#!/usr/bin/env python3
"""
neoize - bring up the shared knowledge graph, load lessons into it and query it.

The graph has two layers. The STRUCTURAL/SYMBOL layer is produced by a per-project collector (the
`neoize-init` skill proposes one for your codebase, because what counts as structure is yours, not
generic). The KNOWLEDGE layer is authored lessons in .neoize/lessons/*.json, loaded on top, and is
fully generic. This CLI owns the database lifecycle and the generic knowledge layer.

Every node carries a `product` discriminant, in BOTH server modes, so a graph always knows which product
it belongs to. One product id is reserved: `shared`. It is the universal layer, the knowledge that holds
for everything done with Claude on this machine (git discipline, PR flow, verification, writing voice).
It lives in the GLOBAL server, so in global mode a session READS the UNION of `shared` and its own product
(reads bind $products = [shared, <this product>] and scope with `product IN $products`), with universal
knowledge always in view and the project's own lessons complementing it. A session WRITES to a single
product: structure and project lessons go to the project, universal lessons are promoted to `shared`. The
mode is a lifecycle choice made at init and stored in .neoize/project.json:
  global  (default) - ONE shared Neo4j for the whole machine, at ~/.neoize/ (override NEOIZE_HOME),
                      container neoize-neo4j. shared and every project live in it, kept apart by product,
                      so a session reads the shared+project union. This is the mode for a shared baseline.
  project           - this project runs its own Neo4j (container neoize-<product>, its own volume and
                      ports, compose in .neoize/). Physically separate and SELF-CONTAINED: it holds only
                      this product, with no shared layer, for a graph that must stay isolated.
A project declares its product in .neoize/project.json (default: the git repo name; set with
`neoize product --set`). The structural reset and the loaders scope by a single product, so one product
never overwrites another; reads span the shared+project union; `neoize promote` moves a project lesson up
into the shared layer.

  neoize up                 # start the ONE shared Neo4j (docker compose, loopback only)
  neoize down               # stop it (keeps the volume; `down --wipe` drops it too)
  neoize status             # is it up, the shared+project counts this session reads and the roster
  neoize load-lessons ...   # load authored lessons for this product (delegates to scripts/load-lessons)
  neoize load-graph <file>  # load this product's collector .cypher, resetting only its structural layer
  neoize shared load        # load the universal lessons store (~/.neoize/shared/lessons) into `shared`
  neoize apply              # end of work: regenerate + load structure, symbols, lessons, shared, always-on block
  neoize always-on [--write] # print (or write into the rules file) the scope:always lessons block
  neoize check [path]       # validate lessons files against the schema: enums, required, dup ids, supersedes
  neoize sync-queries       # re-sync .neoize/queries from the plugin templates (queries only; dry by default)
  neoize check-graph        # run the project's structural check (.neoize/check.py), if it has one
  neoize query "<cypher>"   # run one Cypher query ($product and $products are bound for scoping)
  neoize product [--set ID] # print (or set) the product and mode this project resolves to
  neoize promote --lessons x,y  # move project lessons up into the shared layer (~/.neoize/shared)

Connection from the environment, with local defaults matching the shipped docker-compose:
  NEOIZE_NEO4J_CONTAINER (neoize-neo4j), NEOIZE_NEO4J_USER (neo4j), NEOIZE_NEO4J_PASSWORD (neoize-local)
  NEOIZE_PRODUCT overrides the resolved product; NEOIZE_HOME overrides where the shared server lives.
Under the plugin the MCP server receives the connection from the user's configured options (userConfig);
this CLI reads whatever is in the environment, so set it yourself for a direct terminal run. The compose
used by `up`/`down` is ~/.neoize/docker-compose.neo4j.yml (materialised from the bundled template on first
`up`); a legacy .neoize/docker-compose.neo4j.yml in the project is still honoured if present.
"""
import argparse
import difflib
import glob
import json
import os
import re
import shutil
import subprocess
import sys

import lessonschema

_HERE = os.path.dirname(os.path.abspath(__file__))
_PLUGIN_ROOT = os.path.dirname(_HERE)          # scripts/ -> plugin root

# The reserved product id for the universal layer: knowledge that holds for all work with Claude on this
# machine, read by every session on top of its own product. Never a project's own product id.
SHARED = "shared"


def _project_dir():
    return os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd()


def _neoize_dir():
    return os.path.join(_project_dir(), ".neoize")


def _project_json():
    try:
        return json.load(open(os.path.join(_neoize_dir(), "project.json"), encoding="utf-8"))
    except Exception:
        return {}


def _mode():
    """Server lifecycle mode, chosen at init and stored in project.json. 'global' (the default) shares ONE
    server across every product on this machine; 'project' gives this project its own container and volume.
    It is a lifecycle choice only: every node carries the `product` discriminant either way, so a
    per-project graph stays compatible with the shared one and can be merged or shared into it later."""
    return (_project_json().get("mode") or "global").lower()


def _container():
    """The container to connect to (every tool reaches the graph with `docker exec <container>`). An
    explicit project.json "container" wins; else in project mode it is neoize-<product> (the project owns
    its server); else the configured/global default."""
    pj = _project_json()
    if pj.get("container"):
        return pj["container"]
    if _mode() == "project":
        return f"neoize-{_product()}"
    return os.environ.get("NEOIZE_NEO4J_CONTAINER") or "neoize-neo4j"


def _env():
    return (_container(),
            os.environ.get("NEOIZE_NEO4J_USER") or "neo4j",
            os.environ.get("NEOIZE_NEO4J_PASSWORD") or "neoize-local")


def _shared_dir():
    """Where the ONE shared Neo4j server lives, decoupled from any project. A single container serves
    every product; a project contributes only its authored data (lessons, collector, product id), never
    its own database. Override with NEOIZE_HOME."""
    return os.environ.get("NEOIZE_HOME") or os.path.join(os.path.expanduser("~"), ".neoize")


def _shared_store():
    """The universal lessons store, decoupled from any project: the authored home of the `shared` product.
    Lessons here are loaded into product=shared and read by every session. Version-control it so the
    universal wisdom has a history."""
    return os.path.join(_shared_dir(), "shared")


def _shared_lessons_dir():
    return os.path.join(_shared_store(), "lessons")


def _read_products():
    """The products a read spans: the shared baseline joined with this project's own, so a session always
    sees universal knowledge and its project's lessons together. Bound as $products on every read and
    scoped with `product IN $products`. Just [shared] when there is no distinct project product."""
    cur = _product()
    return [SHARED] if cur == SHARED else [SHARED, cur]


def _product():
    """The product this project's nodes belong to: the discriminant every graph node carries so one
    server holds many products without them colliding. Resolved, in order: NEOIZE_PRODUCT (explicit,
    for CI or a cross-product run), .neoize/project.json's "product", the git repo name, the dir name.
    A product may span several repos, so it is declared in project.json rather than inferred per repo."""
    env = os.environ.get("NEOIZE_PRODUCT")
    if env:
        return env
    p = _project_json().get("product")
    if p:
        return p
    proj = _project_dir()
    try:
        top = subprocess.run(["git", "-C", proj, "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True, check=False).stdout.strip()
        if top:
            return os.path.basename(top)
    except Exception:
        pass
    return os.path.basename(os.path.abspath(proj))


def _compose_file():
    """Which compose `up`/`down` drive. In project mode it is the project's own .neoize compose (init
    scaffolds it with a product-specific container, volume and ports). In global mode it is the shared
    ~/.neoize compose. In either mode a missing file falls back to the bundled template, which the caller
    guards against for project mode (the template is the global container and would collide)."""
    if _mode() == "project":
        local = os.path.join(_neoize_dir(), "docker-compose.neo4j.yml")
        if os.path.isfile(local):
            return local
        return os.path.join(_PLUGIN_ROOT, "templates", "docker-compose.neo4j.yml")
    shared = os.path.join(_shared_dir(), "docker-compose.neo4j.yml")
    if os.path.isfile(shared):
        return shared
    return os.path.join(_PLUGIN_ROOT, "templates", "docker-compose.neo4j.yml")


def _ensure_shared_compose():
    """Materialise the shared compose under ~/.neoize on first use, so `up` targets one project-independent
    server. Returns its path."""
    dst = os.path.join(_shared_dir(), "docker-compose.neo4j.yml")
    if not os.path.isfile(dst):
        os.makedirs(_shared_dir(), exist_ok=True)
        shutil.copyfile(os.path.join(_PLUGIN_ROOT, "templates", "docker-compose.neo4j.yml"), dst)
    return dst


def _container_running(container):
    try:
        out = subprocess.run(["docker", "ps", "--format", "{{.Names}}"],
                             capture_output=True, text=True, check=False)
    except FileNotFoundError:
        print("docker not found on PATH.", file=sys.stderr)
        return False
    return container in out.stdout.split()


def _cypher(script, params=None):
    container, user, pw = _env()
    cmd = ["docker", "exec", "-i", container, "cypher-shell", "-u", user, "-p", pw, "--format", "plain"]
    # $product (this project's single write/primary product) and $products (the shared+project read union)
    # are bound on every call so a query can scope with {product:$product} or `product IN $products` without
    # the caller passing them; an explicit param overrides either.
    merged = {"product": _product(), "products": _read_products()}
    merged.update(params or {})
    for k, v in merged.items():
        # "name => <cypher literal>"; a JSON-encoded scalar or list is a valid literal.
        cmd += ["--param", f"{k} => {json.dumps(v, ensure_ascii=False)}"]
    return subprocess.run(cmd, input=script, text=True, capture_output=True, check=False)


# ----------------------------------------------------------------------------- lifecycle
def _published_ports(compose):
    """The host ports the compose publishes for the Browser (7474) and Bolt (7687), so `up` can print the
    right URL in project mode where init assigns unique ports. Defaults to the standard pair."""
    http, bolt = "7474", "7687"
    try:
        for line in open(compose, encoding="utf-8"):
            m = re.search(r"(\d+):7474", line)
            if m:
                http = m.group(1)
            m = re.search(r"(\d+):7687", line)
            if m:
                bolt = m.group(1)
    except Exception:
        pass
    return http, bolt


def cmd_up(args):
    if _mode() == "project":
        compose = os.path.join(_neoize_dir(), "docker-compose.neo4j.yml")
        if not os.path.isfile(compose):
            print("project mode but no .neoize/docker-compose.neo4j.yml exists. Run /neoize:init to "
                  "scaffold this project's own server, or switch to global mode.", file=sys.stderr)
            return 1
        print(f"Starting the per-project Neo4j from {compose} ...")
    else:
        compose = _ensure_shared_compose()
        print(f"Starting the shared Neo4j from {compose} ...")
    rc = subprocess.run(["docker", "compose", "-f", compose, "up", "-d"], check=False).returncode
    if rc == 0:
        http, bolt = _published_ports(compose)
        print(f"Up. Browser: http://localhost:{http}   Bolt: bolt://127.0.0.1:{bolt}")
    return rc


def cmd_down(args):
    compose = _compose_file()
    cmd = ["docker", "compose", "-f", compose, "down"]
    if args.wipe:
        cmd.append("-v")
        print("Stopping Neo4j and DROPPING its volume ...")
    else:
        print("Stopping Neo4j (volume kept) ...")
    return subprocess.run(cmd, check=False).returncode


def cmd_status(args):
    container, _, _ = _env()
    if not _container_running(container):
        print(f"Neo4j container '{container}' is NOT running. Start it with: neoize up")
        return 1
    product = _product()
    products = _read_products()
    print(f"Neo4j '{container}' is up ({_mode()} mode).")
    print(f"This session reads the union {products} (writes go to '{product}').")
    # Node counts for the union this session actually reads: the project's own plus the shared baseline.
    proc = _cypher("MATCH (n) WHERE n.product IN $products "
                   "RETURN n.product AS product, labels(n)[0] AS label, count(*) AS n "
                   "ORDER BY product, n DESC")
    if proc.returncode != 0:
        sys.stderr.write(proc.stdout + proc.stderr)
        return proc.returncode
    print("\nIn-scope node counts (product, label, n):")
    print(proc.stdout.rstrip() or "  (nothing in scope yet)")
    # One server holds every product; show the full roster so it is obvious what else lives here.
    other = _cypher("MATCH (n) WHERE n.product IS NOT NULL "
                    "RETURN n.product AS product, count(*) AS n ORDER BY product")
    rows = [r for r in other.stdout.strip().splitlines()[1:] if r.strip()]
    if rows:
        print(f"\nAll products on this server ({len(rows)}):")
        print(other.stdout.rstrip())
    return 0


def cmd_query(args):
    container, _, _ = _env()
    if not _container_running(container):
        print(f"Neo4j container '{container}' is not running. Start it with: neoize up", file=sys.stderr)
        return 1
    # $product (this product) and $products (the shared+project read union) are bound, so a terminal query
    # can scope with {product:$product} or `WHERE n.product IN $products`.
    proc = _cypher(args.cypher)
    sys.stdout.write(proc.stdout)
    sys.stderr.write(proc.stderr)
    return proc.returncode


# ----------------------------------------------------------------------------- lessons
def cmd_load_lessons(args):
    loader = os.path.join(_HERE, "load-lessons")
    targets = args.paths or [os.path.join(_neoize_dir(), "lessons")]
    # Pin the product explicitly so the loader stamps the same discriminant the CLI resolved, even if the
    # subprocess sees a different cwd.
    env = dict(os.environ, NEOIZE_PRODUCT=_product())
    return subprocess.run([sys.executable, loader, *(["--prune"] if args.prune else []), *targets],
                          check=False, env=env).returncode


def cmd_load_graph(args):
    """Load a project collector's .cypher into the graph, resetting ONLY the structural projection.
    The knowledge layer (Lesson, Topic, Operation) and any symbol layer (Symbol, File) are preserved,
    because they are authored or expensive to rebuild. Structural nodes are deleted and rebuilt, so the
    lesson-to-structural anchors drop with them: re-run `neoize load-lessons` immediately after, which
    the command reminds you to do.

    The reset and the collector's MERGEs are BOTH scoped to this project's product ($product), so one
    shared server holds many products and rebuilding one never touches another's structure. The
    collector must emit product into its node keys (`{product:$product, id:...}`); a .cypher that does
    not is refused here, because loading it would create product-less nodes the reset can never reclaim
    and would merge two products' same-id nodes into one."""
    container, _, _ = _env()
    if not _container_running(container):
        print(f"Neo4j container '{container}' is not running. Start it with: neoize up", file=sys.stderr)
        return 1
    if not os.path.isfile(args.file):
        print(f"{args.file} not found.", file=sys.stderr)
        return 1
    product = _product()
    cypher = open(args.file, encoding="utf-8").read()
    if "product" not in cypher:
        print(f"{args.file} does not mention `product`, so it predates the shared-server model. Update the "
              f"collector to emit `{{product:$product, id:...}}` in every MERGE key, regenerate it and "
              f"load again. See the migration note in the README.", file=sys.stderr)
        return 1
    reset = ("MATCH (n {product:$product}) WHERE NOT (n:Lesson OR n:Topic OR n:Operation OR n:Symbol OR n:File) "
             "DETACH DELETE n;\n")
    proc = _cypher(reset + cypher, {"product": product})
    sys.stdout.write(proc.stdout)
    sys.stderr.write(proc.stderr)
    if proc.returncode != 0:
        return proc.returncode
    print(f"Loaded {args.file} for product '{product}'. Structural projection reset; "
          f"Lesson/Topic/Operation preserved; other products untouched.")
    print("Re-run `neoize load-lessons` now, so lesson anchors to structural nodes resolve again.")
    return 0


def cmd_check_graph(args):
    """Run the project's own structural check, if it ships one. The check is project-specific logic
    (wiring completeness, an invariant, orphans) living at .neoize/check.py; this just runs it and
    passes its exit code through. A project with no check.py is not an error, it simply has none."""
    check = os.path.join(_neoize_dir(), "check.py")
    if not os.path.isfile(check):
        print(f"No structural check at {check} (this project ships none). Nothing to run.")
        return 0
    return subprocess.run([sys.executable, check, *args.rest], check=False).returncode


def _iter_lesson_files(path):
    if os.path.isdir(path):
        return sorted(glob.glob(os.path.join(path, "*.json")))
    hits = sorted(glob.glob(path))
    return hits if hits else [path]


def cmd_check(args):
    """Validate lessons files against templates/lesson.schema.json WITHOUT touching the graph: required
    fields, the closed enums (kind, scope, confidence, status), unknown fields, duplicate ids, and
    supersedes targets that no loaded file defines. This is the same taxonomy the loader enforces, so a
    file that passes here loads without an enum refusal. Prints the denominator it examined and names the
    lesson and file behind every finding."""
    path = args.path or os.path.join(_neoize_dir(), "lessons")
    files = _iter_lesson_files(path)
    if not files:
        print(f"INCONCLUSIVE: no lessons files found under {path}", file=sys.stderr)
        return 2
    lessons, findings = [], []
    for f in files:
        base = os.path.basename(f)
        try:
            doc = json.load(open(f, encoding="utf-8"))
        except Exception as exc:
            findings.append(("unreadable", base, str(exc)))
            continue
        for l in doc.get("lessons", []):
            lessons.append(l)
            where = f'{l.get("id", "<no id>")} ({base})'
            # Retired lessons are tombstones deleted by id; the loader never stores their other fields,
            # so only check the full schema on what actually loads.
            if l.get("status") != "retired":
                for problem in lessonschema.validate(l):
                    findings.append(("schema", where, problem))
            for a in l.get("anchors", []):
                if "type" not in a or "id" not in a:
                    findings.append(("bad-anchor", where, json.dumps(a)))
    ids = [l.get("id") for l in lessons if l.get("id")]
    seen = set()
    for i in ids:
        if i in seen:
            findings.append(("duplicate-id", i, "defined more than once"))
        seen.add(i)
    known = set(ids)
    for l in lessons:
        for sid in l.get("supersedes", []):
            if sid not in known:
                findings.append(("dangling-supersedes", l.get("id", "<no id>"), f"-> {sid} (not in these files)"))

    print(f"Checked        : {len(lessons)} lesson(s) across {len(files)} file(s)")
    if not findings:
        print("OK: no findings.")
        return 0
    print(f"\n{len(findings)} finding(s):", file=sys.stderr)
    for kind, where, detail in findings:
        print(f"  {kind:20s} {where:28s} {detail}", file=sys.stderr)
    return 1


# ----------------------------------------------------------------------------- product / sharing
def cmd_product(args):
    """Print the product and mode this project resolves to; --set / --mode write them into
    .neoize/project.json so they are stable and can span repos."""
    if args.set or args.mode:
        if args.mode and args.mode not in ("global", "project"):
            print("mode must be 'global' or 'project'.", file=sys.stderr)
            return 1
        nd = _neoize_dir()
        os.makedirs(nd, exist_ok=True)
        path = os.path.join(nd, "project.json")
        try:
            data = json.load(open(path, encoding="utf-8"))
        except Exception:
            data = {}
        if args.set:
            data["product"] = args.set
        if args.mode:
            data["mode"] = args.mode
        with open(path, "w", encoding="utf-8") as fh:
            json.dump(data, fh, ensure_ascii=False, indent=2)
            fh.write("\n")
        print(f"Wrote {path}: product='{data.get('product', _product())}', mode='{data.get('mode', 'global')}'")
        return 0
    print(f"{_product()}  ({_mode()} mode)")
    return 0


def _resolve_lessons_dir(p):
    """From a path that may be a lessons dir, a .neoize dir or a repo root, find the lessons/*.json dir.
    A `lessons` subdirectory is preferred over the path itself, so pointing at a .neoize dir (which also
    holds project.json and triggers.json) still resolves to its lessons/, not to those files."""
    for cand in (os.path.join(p, "lessons"), os.path.join(p, ".neoize", "lessons"), p):
        if os.path.isdir(cand) and glob.glob(os.path.join(cand, "*.json")):
            return cand
    return None


def _read_lessons(ldir):
    out = []
    for f in sorted(glob.glob(os.path.join(ldir, "*.json"))):
        try:
            out += json.load(open(f, encoding="utf-8")).get("lessons", [])
        except Exception as exc:
            print(f"  ! skipped unreadable {f}: {exc}", file=sys.stderr)
    return out


def _is_promotable(l):
    """Shaped to belong in the shared layer: not retired and anchored to at least one Topic or Operation.
    A lesson that only anchors to a structural/symbol node is about one product's own code and cannot be
    universal, so it is never a promotion candidate. Shape is necessary, not sufficient: whether the
    CONTENT is truly universal is a human call."""
    return l.get("status") != "retired" and any(
        a.get("type") in ("Topic", "Operation") for a in l.get("anchors", []))


def _lesson_file_index(ldir):
    """Map lesson id -> (file path, the lesson object), across every *.json in a lessons dir."""
    index = {}
    for f in sorted(glob.glob(os.path.join(ldir, "*.json"))):
        try:
            doc = json.load(open(f, encoding="utf-8"))
        except Exception as exc:
            print(f"  ! skipped unreadable {f}: {exc}", file=sys.stderr)
            continue
        for l in doc.get("lessons", []):
            if l.get("id"):
                index[l["id"]] = (f, l)
    return index


def _rewrite_without(path, drop_ids):
    """Remove the given lesson ids from a lessons file, keeping its other keys, then write it back."""
    doc = json.load(open(path, encoding="utf-8"))
    doc["lessons"] = [l for l in doc.get("lessons", []) if l.get("id") not in drop_ids]
    with open(path, "w", encoding="utf-8") as fh:
        json.dump(doc, fh, ensure_ascii=False, indent=2)
        fh.write("\n")


def cmd_promote(args):
    """Move project lessons UP into the shared layer, so knowledge that holds for all work with Claude
    stops being one project's secret and is read by every session. It is a file operation (the lessons
    files are the source of truth, the graph is a projection): the chosen lessons leave this project's
    lessons files and land in ~/.neoize/shared/lessons/from-<product>.json, keeping only their
    Topic/Operation anchors (a structural anchor would dangle in shared, which has no code). Nothing is
    loaded; run `neoize shared load` and re-run this project's `neoize load-lessons` afterwards. The move
    is reversible through git in both the project and the shared store. Pass --copy to leave the project
    copy in place, but then it lives in two products and the union read shows it twice, so move is the
    default."""
    product = _product()
    if product == SHARED:
        print("already on the shared product; nothing to promote into.", file=sys.stderr)
        return 1
    my_dir = os.path.join(_neoize_dir(), "lessons")
    index = _lesson_file_index(my_dir) if os.path.isdir(my_dir) else {}
    cands = {i: (f, l) for i, (f, l) in index.items() if _is_promotable(l)}
    if args.list or not args.lessons:
        print(f"Promotable lessons in '{product}' ({my_dir}) - {len(cands)} of {len(index)}:")
        for i, (_, l) in sorted(cands.items()):
            print(f"  {i}  - {l.get('title', '')}")
        if not args.lessons:
            print("\nPromote with: neoize promote --lessons <id,id,...>   (only genuinely universal ones)")
        return 0
    want = [s.strip() for s in args.lessons.split(",") if s.strip()]
    missing = [i for i in want if i not in index]
    if missing:
        print(f"not found in '{product}': {', '.join(missing)}", file=sys.stderr)
        return 1
    not_shaped = [i for i in want if i not in cands]
    if not_shaped:
        print(f"not promotable (no Topic/Operation anchor, so they cannot be universal): "
              f"{', '.join(not_shaped)}", file=sys.stderr)
        return 1

    sdir = _shared_lessons_dir()
    os.makedirs(sdir, exist_ok=True)
    out_path = os.path.join(sdir, f"from-{product}.json")
    existing = []
    if os.path.isfile(out_path):
        existing = json.load(open(out_path, encoding="utf-8")).get("lessons", [])
    have = {l.get("id") for l in existing}
    moved, skipped = [], []
    for i in want:
        if i in have:
            skipped.append(i)
            continue
        _, l = index[i]
        c = dict(l)
        c["anchors"] = [a for a in l.get("anchors", []) if a.get("type") in ("Topic", "Operation")]
        existing.append(c)
        moved.append(i)
    doc = {"_source": f"Universal lessons promoted from product(s) into the shared layer. Read by every "
                      f"session on top of its own product.",
           "lessons": existing}
    with open(out_path, "w", encoding="utf-8") as fh:
        json.dump(doc, fh, ensure_ascii=False, indent=2)
        fh.write("\n")
    if not args.copy and moved:
        # remove the promoted lessons from their project files, grouped per file
        per_file = {}
        for i in moved:
            per_file.setdefault(index[i][0], set()).add(i)
        for f, ids in per_file.items():
            _rewrite_without(f, ids)

    print(f"Promoted {len(moved)} lesson(s) from '{product}' into {out_path}.")
    if moved:
        print(f"  moved: {', '.join(moved)}")
    if skipped:
        print(f"  already in shared, left alone: {', '.join(skipped)}")
    print("Structural/symbol anchors were dropped; only Topic/Operation anchors travel.")
    verb = "copied (still in the project too)" if args.copy else "removed from the project files"
    print(f"The project copies were {verb}.")
    print("Load both layers now:  neoize shared load   &&   neoize load-lessons --prune")
    return 0


def _global_container():
    """The global server's container. The shared layer always lives in the one global server, never in a
    project-mode container, so shared operations target this regardless of the current project's mode."""
    return os.environ.get("NEOIZE_NEO4J_CONTAINER") or "neoize-neo4j"


def cmd_shared(args):
    """Lifecycle of the universal (shared) layer: the authored store at ~/.neoize/shared/lessons loads into
    product=shared in the GLOBAL server, which every session reads on top of its own product."""
    if args.shared_cmd == "dir":
        print(_shared_store())
        return 0
    container = _global_container()
    if not _container_running(container):
        print(f"Global Neo4j container '{container}' is not running. Start it with: neoize up (global "
              f"mode).", file=sys.stderr)
        return 1
    if args.shared_cmd == "status":
        proc = subprocess.run(
            ["docker", "exec", "-i", container, "cypher-shell", "-u",
             os.environ.get("NEOIZE_NEO4J_USER") or "neo4j", "-p",
             os.environ.get("NEOIZE_NEO4J_PASSWORD") or "neoize-local", "--format", "plain",
             "--param", f"p => {json.dumps(SHARED)}"],
            input="MATCH (n {product:$p}) RETURN labels(n)[0] AS label, count(*) AS n ORDER BY n DESC",
            text=True, capture_output=True, check=False)
        print("Shared layer node counts by label:")
        print(proc.stdout.rstrip() if proc.stdout.strip() else "  (shared layer is empty)")
        return proc.returncode
    # load: force the shared product and the global container, so project mode cannot misdirect it.
    sdir = _shared_lessons_dir()
    if not (os.path.isdir(sdir) and glob.glob(os.path.join(sdir, "*.json"))):
        print(f"no lessons/*.json in the shared store ({sdir}). Promote some lessons there first, or "
              f"author them under {sdir}.", file=sys.stderr)
        return 1
    loader = os.path.join(_HERE, "load-lessons")
    env = dict(os.environ, NEOIZE_PRODUCT=SHARED, NEOIZE_NEO4J_CONTAINER=container)
    return subprocess.run([sys.executable, loader, *(["--prune"] if args.prune else []), sdir],
                          check=False, env=env).returncode


# ----------------------------------------------------------------------------- always-on rules block
# A scope:always lesson must be in view every session, not fetched on demand, so it is materialised into
# the project's always-on rules file (the CLAUDE.md-style file every session already loads) as a managed
# block between these markers. The graph is the source of truth; this block is generated from it, so an
# always-on rule is authored ONCE as a lesson and never hand-copied into the rules file.
ALWAYS_START = "<!-- neoize:always-on:START - generated from scope:always lessons by `neoize apply`; edit the lesson, not this block -->"
ALWAYS_END = "<!-- neoize:always-on:END -->"


def _rules_file():
    """The always-on rules file this project materialises scope:always lessons into. project.json
    'rules_file' (relative to the project, or absolute) wins; the default is CLAUDE.md at the project root,
    the file a session already loads every time."""
    rf = _project_json().get("rules_file") or "CLAUDE.md"
    return rf if os.path.isabs(rf) else os.path.join(_project_dir(), rf)


def _lessons_in(d):
    """Every lesson object authored under a directory of *.json, without the graph. Empty when the dir is
    absent, so a project with no shared layer or no lessons simply contributes nothing. A file that does
    not parse is skipped here; `neoize check` is where a malformed file is reported."""
    out = []
    if d and os.path.isdir(d):
        for f in sorted(glob.glob(os.path.join(d, "*.json"))):
            try:
                out += json.load(open(f, encoding="utf-8")).get("lessons", [])
            except Exception:
                pass
    return out


def _always_on_lessons():
    """The scope:always lessons for this session's read union, read from the AUTHORED files (the same
    source the loader reads), ordered stably so the generated block is deterministic. Shared layer first,
    then this project; retired tombstones excluded. Global mode reads shared+project; project mode and the
    shared product itself read only their own lessons."""
    layers = []
    if _mode() != "project" and _product() != SHARED:
        layers.append(("0-shared", _lessons_in(_shared_lessons_dir())))
    layers.append(("1-project", _lessons_in(os.path.join(_neoize_dir(), "lessons"))))
    picked = []
    for rank, lessons in layers:
        for l in lessons:
            if l.get("scope") == "always" and l.get("status") != "retired":
                picked.append((rank, l.get("id", ""), l))
    picked.sort(key=lambda t: (t[0], t[1]))
    return [l for _, _, l in picked]


def _render_always_block(lessons):
    """The managed block: the two markers around a heading and one bullet per always-on lesson. It is a
    pure function of the lessons, so `neoize apply` regenerates it byte-for-byte when nothing changed and
    leaves no spurious diff."""
    lines = [ALWAYS_START,
             "## Always-on lessons (neoize)",
             "",
             "Loaded every session from the knowledge graph, because they must not wait for an anchor "
             "match. Do not edit here. Edit the `scope: always` lesson and run `neoize apply`.",
             ""]
    if lessons:
        for l in lessons:
            lines.append(f"- **{l.get('title', '').strip()}** {l.get('body', '').strip()}")
    else:
        lines.append("- (none yet: author a lesson with `scope: always` to populate this)")
    lines.append(ALWAYS_END)
    return "\n".join(lines)


def _splice_always_block(text, block):
    """Replace an existing START..END block in `text`, or return None when the markers are not both there.
    Only the span between (and including) the markers changes, so the rest of the file stays byte-for-byte."""
    i = text.find(ALWAYS_START)
    j = text.find(ALWAYS_END)
    if i == -1 or j == -1 or j < i:
        return None
    return text[:i] + block + text[j + len(ALWAYS_END):]


def cmd_always_on(args):
    """Print, or with --write materialise, the always-on rules block for this project. The block is
    generated from the scope:always lessons in this session's read union, read from the authored files, so
    the graph need not be up. --write updates the block in place between its markers, or appends a fresh
    block (with the markers) when the rules file has none yet. Nothing outside the markers is touched, and
    the rules file is never created for you."""
    lessons = _always_on_lessons()
    block = _render_always_block(lessons)
    if not getattr(args, "write", False):
        print(block)
        return 0
    path = _rules_file()
    if not os.path.isfile(path):
        print(f"rules file {path} does not exist. Create it (or point project.json \"rules_file\" at an "
              f"existing file) before materialising the always-on block; neoize will not create it.",
              file=sys.stderr)
        return 1
    text = open(path, encoding="utf-8").read()
    spliced = _splice_always_block(text, block)
    if spliced is None:
        sep = "" if text.endswith("\n\n") else ("\n" if text.endswith("\n") else "\n\n")
        spliced = text + sep + block + "\n"
        action = f"appended a new always-on block to {path}"
    elif spliced == text:
        print(f"{path}: always-on block already current ({len(lessons)} lesson(s)). Nothing to write.")
        return 0
    else:
        action = f"updated the always-on block in {path}"
    open(path, "w", encoding="utf-8").write(spliced)
    print(f"{action} ({len(lessons)} always-on lesson(s)).")
    return 0


# ----------------------------------------------------------------------------- apply (full graph refresh)
def cmd_apply(args):
    """Apply EVERYTHING authored to the live graph in one pass: the end-of-work companion to wrap. It
    regenerates and loads the structural layer, runs the project's symbol-layer refresh if it declares one,
    loads this project's lessons, loads the shared layer, then regenerates the always-on rules block, all
    scoped to this product. It is the single command that takes 'I saved the JSON' to 'the graph is current',
    so a lesson or a new symbol is actually retrievable, not just on disk.

    Each step is skipped cleanly when it does not apply, and the run stops on the first failure:
      1. structure - run .neoize/collect.py (if present), then load-graph the .cypher it writes (resets
                     only this product's structural projection).
      2. symbols   - run project.json "symbols_refresh" (a shell command) if set, with NEOIZE_PRODUCT and
                     the container bound. This is where a project regenerates and loads its own symbol layer
                     (its language-specific extractor and loader), which the plugin cannot do generically.
      3. lessons   - load-lessons --prune over .neoize/lessons (the full set, so retired or moved lessons
                     also leave the graph), which re-resolves the anchors a structural reload dropped.
      4. shared    - load the universal store (global mode only), pruned like the project layer, so a
                     lesson routed to shared this session lands and a retired one leaves. Both layers prune
                     against their own store, so --no-prune makes both purely additive.
      5. always-on - regenerate the scope:always block in the rules file (project.json "rules_file",
                     default CLAUDE.md), but only when it already carries the markers. A project adopts the
                     block once with `neoize always-on --write`; apply keeps it current from then on."""
    from argparse import Namespace
    # The step headers print from this process while the sub-steps write to stdout directly, so keep the
    # two in order by flushing this process's prints on every newline.
    try:
        sys.stdout.reconfigure(line_buffering=True)
    except Exception:
        pass
    container, _, _ = _env()
    if not _container_running(container):
        print(f"Neo4j container '{container}' is not running. Start it with: neoize up", file=sys.stderr)
        return 1
    product = _product()
    prune = not args.no_prune
    print(f"Applying everything to the graph for product '{product}' ({_mode()} mode).\n")

    collect = os.path.join(_neoize_dir(), "collect.py")
    gcypher = os.path.join(_neoize_dir(), "graph.cypher")
    if os.path.isfile(collect):
        print("== 1/5 structure: regenerate (collect.py) ==")
        rc = subprocess.run([sys.executable, collect], cwd=_project_dir(), check=False).returncode
        if rc != 0:
            print("collect.py failed; stopping before anything is loaded.", file=sys.stderr)
            return rc
        if os.path.isfile(gcypher):
            print("== 1/5 structure: load-graph ==")
            rc = cmd_load_graph(Namespace(file=gcypher))
            if rc != 0:
                return rc
        else:
            print(f"(collect.py ran but wrote no {gcypher}; skipping load-graph)")
    else:
        print("== 1/5 structure: no .neoize/collect.py, skipping ==")

    sr = _project_json().get("symbols_refresh")
    if sr:
        print(f"\n== 2/5 symbols: project symbols_refresh ==\n$ {sr}")
        env = dict(os.environ, NEOIZE_PRODUCT=product, NEOIZE_NEO4J_CONTAINER=container)
        rc = subprocess.run(sr, shell=True, cwd=_project_dir(), env=env, check=False).returncode
        if rc != 0:
            print("symbols_refresh failed; stopping before lessons so anchors are not half-resolved.",
                  file=sys.stderr)
            return rc
    else:
        print("\n== 2/5 symbols: no 'symbols_refresh' in project.json, skipping ==")

    ldir = os.path.join(_neoize_dir(), "lessons")
    if os.path.isdir(ldir) and glob.glob(os.path.join(ldir, "*.json")):
        print(f"\n== 3/5 lessons: load-lessons{' --prune' if prune else ''} ==")
        rc = cmd_load_lessons(Namespace(paths=None, prune=prune))
        if rc != 0:
            return rc
    else:
        print("\n== 3/5 lessons: no .neoize/lessons/*.json, skipping ==")

    if _mode() != "project":
        sdir = _shared_lessons_dir()
        if os.path.isdir(sdir) and glob.glob(os.path.join(sdir, "*.json")):
            print(f"\n== 4/5 shared: load the universal layer{' --prune' if prune else ''} ==")
            rc = cmd_shared(Namespace(shared_cmd="load", prune=prune))
            if rc != 0:
                return rc
        else:
            print("\n== 4/5 shared: the universal store is empty, skipping ==")
    else:
        print("\n== 4/5 shared: project mode has no shared layer, skipping ==")

    # 5. always-on: regenerate the managed block in the rules file, but ONLY when the project has already
    #    opted in by having the markers. apply never injects a block into a rules file unasked; a project
    #    adopts it once with `neoize always-on --write`, and after that every apply keeps it current.
    rf = _rules_file()
    always = _always_on_lessons()
    if os.path.isfile(rf) and ALWAYS_START in open(rf, encoding="utf-8").read():
        print(f"\n== 5/5 always-on: regenerate the block in {os.path.basename(rf)} ==")
        rc = cmd_always_on(Namespace(write=True))
        if rc != 0:
            return rc
    elif always:
        print(f"\n== 5/5 always-on: {len(always)} scope:always lesson(s) not materialised ==")
        print(f"   {os.path.basename(rf)} has no neoize:always-on block yet; run "
              f"`neoize always-on --write` to add one.")
    else:
        print("\n== 5/5 always-on: no scope:always lessons, skipping ==")

    print(f"\nDone. The graph is current for product '{product}'.")
    return 0


# ----------------------------------------------------------------------------- main
def cmd_sync_queries(args):
    """Re-sync .neoize/queries/*.cypher from the plugin's shipped query templates. QUERIES ONLY: it never
    touches lessons, the collector, triggers, project.json, wrap.md or any other authored .neoize content.
    The saved queries were copied from the templates at init, so a plugin that improves them (for example
    the shared+project union scoping) leaves a project's copies behind; this brings them forward.

    The default is a DRY RUN: it classifies each template as new, changed or up-to-date and writes nothing.
    --diff prints the unified diff of each changed file (yours vs the template) so a customised query is
    obvious before you overwrite it. --write applies, copying only the query files."""
    src = os.path.join(_PLUGIN_ROOT, "templates", "queries")
    dst = os.path.join(_neoize_dir(), "queries")
    if not os.path.isdir(src):
        print(f"no shipped query templates at {src}.", file=sys.stderr)
        return 1
    new, changed, same = [], [], []
    for sf in sorted(glob.glob(os.path.join(src, "*.cypher"))):
        name = os.path.basename(sf)
        s = open(sf, encoding="utf-8").read()
        df = os.path.join(dst, name)
        if not os.path.isfile(df):
            new.append(name)
        elif open(df, encoding="utf-8").read() == s:
            same.append(name)
        else:
            changed.append(name)
    print(f"Query templates vs {dst}: {len(new)} new, {len(changed)} changed, {len(same)} up to date.")
    for name in new:
        print(f"  new      {name}")
    for name in changed:
        print(f"  changed  {name}  (your copy differs from the template)")
    if args.diff:
        for name in changed:
            yours = open(os.path.join(dst, name), encoding="utf-8").read().splitlines(keepends=True)
            tmpl = open(os.path.join(src, name), encoding="utf-8").read().splitlines(keepends=True)
            print(f"\n=== {name}: yours (-) vs template (+) ===")
            sys.stdout.writelines(difflib.unified_diff(yours, tmpl, fromfile=f"yours/{name}",
                                                        tofile=f"template/{name}"))
    if not args.write:
        if new or changed:
            print("\nDry run, nothing written. Re-run with --write to apply (queries only; lessons, collector "
                  "and the rest of .neoize are never touched). Add --diff to review changes first.")
        return 0
    os.makedirs(dst, exist_ok=True)
    for name in new + changed:
        shutil.copyfile(os.path.join(src, name), os.path.join(dst, name))
    print(f"Wrote {len(new) + len(changed)} query file(s) to {dst}. "
          f"Lessons, collector and the rest of .neoize untouched.")
    return 0


def main():
    ap = argparse.ArgumentParser(description="Bring up, load and query the local knowledge graph.")
    sub = ap.add_subparsers(dest="cmd")

    sub.add_parser("up", help="start the local Neo4j").set_defaults(func=cmd_up)
    d = sub.add_parser("down", help="stop the local Neo4j")
    d.add_argument("--wipe", action="store_true", help="also drop the data volume")
    d.set_defaults(func=cmd_down)
    sub.add_parser("status", help="is it up, and what does it hold").set_defaults(func=cmd_status)

    ll = sub.add_parser("load-lessons", help="load authored lessons into the graph")
    ll.add_argument("paths", nargs="*", help="files/dirs/globs (default .neoize/lessons)")
    ll.add_argument("--prune", action="store_true", help="delete graph lessons absent from the loaded set")
    ll.set_defaults(func=cmd_load_lessons)

    lg = sub.add_parser("load-graph", help="load a collector's .cypher, resetting only the structural layer")
    lg.add_argument("file", help="the .cypher file written by .neoize/collect.py")
    lg.set_defaults(func=cmd_load_graph)

    ck = sub.add_parser("check", help="validate lessons files locally (no graph)")
    ck.add_argument("path", nargs="?", help="file/dir/glob (default .neoize/lessons)")
    ck.set_defaults(func=cmd_check)

    sq = sub.add_parser("sync-queries", help="re-sync .neoize/queries from the plugin templates (queries only)")
    sq.add_argument("--write", action="store_true", help="apply (default is a dry run)")
    sq.add_argument("--diff", action="store_true", help="show the unified diff of each changed file")
    sq.set_defaults(func=cmd_sync_queries)

    cg = sub.add_parser("check-graph", help="run the project's structural check (.neoize/check.py)")
    cg.add_argument("rest", nargs=argparse.REMAINDER, help="args passed through to check.py")
    cg.set_defaults(func=cmd_check_graph)

    q = sub.add_parser("query", help="run one Cypher query")
    q.add_argument("cypher", help="the Cypher query")
    q.set_defaults(func=cmd_query)

    pr = sub.add_parser("product", help="print or set the product and mode this project resolves to")
    pr.add_argument("--set", metavar="ID", help="write this product id into .neoize/project.json")
    pr.add_argument("--mode", choices=["global", "project"], help="write the server mode into .neoize/project.json")
    pr.set_defaults(func=cmd_product)

    pm = sub.add_parser("promote", help="move project lessons up into the shared (universal) layer")
    pm.add_argument("--lessons", help="comma-separated lesson ids to promote")
    pm.add_argument("--list", action="store_true", help="list this project's promotable lessons and stop")
    pm.add_argument("--copy", action="store_true",
                    help="leave the project copy in place (default moves it, to avoid a double in the union)")
    pm.set_defaults(func=cmd_promote)

    sd = sub.add_parser("shared", help="lifecycle of the universal (shared) layer in the global server")
    sd.add_argument("shared_cmd", choices=["load", "status", "dir"],
                    help="load ~/.neoize/shared/lessons into product=shared, show its counts, or print its path")
    sd.add_argument("--prune", action="store_true", help="on load, delete shared lessons absent from the store")
    sd.set_defaults(func=cmd_shared)

    ap_apply = sub.add_parser("apply",
                              help="apply everything (structure, symbols, lessons, shared, always-on) to the graph")
    ap_apply.add_argument("--no-prune", action="store_true",
                          help="keep graph lessons absent from the files (default prunes the project layer)")
    ap_apply.set_defaults(func=cmd_apply)

    ao = sub.add_parser("always-on",
                        help="print, or --write, the always-on rules block (the scope:always lessons)")
    ao.add_argument("--write", action="store_true",
                    help="materialise the block into the rules file (project.json 'rules_file', default CLAUDE.md)")
    ao.set_defaults(func=cmd_always_on)

    args = ap.parse_args()
    if not getattr(args, "func", None):
        ap.print_help()
        return 2
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
